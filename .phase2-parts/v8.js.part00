import v7 from "./v7.js";

const GITHUB_API = "https://api.github.com";
const API_VERSION = "2022-11-28";
const DEFAULT_BRANCH = "main";
const SUBMISSIONS_PATH = "docs/data/submissions.json";
const MAX_INLINE_BYTES = 10 * 1024 * 1024;
const TEXT_EXTENSIONS = new Set(["txt", "log", "out", "err", "csv", "tsv", "xml", "yaml", "yml", "ini", "cfg"]);
const CODE_EXTENSIONS = new Set([
  "cmd", "tcl", "py", "js", "mjs", "cjs", "ts", "tsx", "jsx", "c", "cc", "cpp", "cxx", "h", "hpp",
  "java", "kt", "kts", "go", "rs", "sh", "bash", "zsh", "ps1", "v", "sv", "vhd", "vhdl", "sp", "cir",
  "scm", "r", "m", "sql", "html", "htm", "css", "scss", "less"
]);
const IMAGE_MIME = {
  png: "image/png",
  jpg: "image/jpeg",
  jpeg: "image/jpeg",
  webp: "image/webp",
  gif: "image/gif",
  svg: "image/svg+xml",
  bmp: "image/bmp",
  avif: "image/avif"
};
const MIME_BY_EXTENSION = {
  ...IMAGE_MIME,
  pdf: "application/pdf",
  json: "application/json; charset=utf-8",
  md: "text/markdown; charset=utf-8",
  markdown: "text/markdown; charset=utf-8",
  txt: "text/plain; charset=utf-8",
  log: "text/plain; charset=utf-8",
  out: "text/plain; charset=utf-8",
  err: "text/plain; charset=utf-8",
  csv: "text/csv; charset=utf-8",
  tsv: "text/tab-separated-values; charset=utf-8",
  xml: "application/xml; charset=utf-8",
  yaml: "text/yaml; charset=utf-8",
  yml: "text/yaml; charset=utf-8",
  zip: "application/zip",
  docx: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
  pptx: "application/vnd.openxmlformats-officedocument.presentationml.presentation",
  xlsx: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
  xls: "application/vnd.ms-excel"
};

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    if (request.method === "OPTIONS") {
      return corsResponse(new Response(null, { status: 204 }), request, env);
    }

    const manifestRoute = url.pathname.match(/^\/api\/submissions\/([A-Za-z0-9_-]+)\/manifest$/);
    const fileRoute = url.pathname.match(/^\/api\/submissions\/([A-Za-z0-9_-]+)\/files\/(f\d+)(\/download)?$/);
    if (!manifestRoute && !fileRoute) return v7.fetch(request, env, ctx);

    try {
      if (request.method !== "GET" && request.method !== "HEAD") {
        throw httpError(405, "지원하지 않는 요청 방식입니다.");
      }
      const token = await optionalReadToken(request, env);
      if (manifestRoute) {
        const payload = await buildManifest({
          request,
          env,
          token,
          submissionId: manifestRoute[1],
          outputId: url.searchParams.get("outputId")
        });
        return corsJson(payload, request, env, 200, {
          "Cache-Control": "public, max-age=30, stale-while-revalidate=120"
        });
      }

      const payload = await loadSubmissionContext({
        env,
        token,
        submissionId: fileRoute[1],
        outputId: url.searchParams.get("outputId")
      });
      const index = Number(fileRoute[2].slice(1));
      const file = payload.files[index];
      if (!file) throw httpError(404, "요청한 파일을 찾지 못했습니다.");
      validateSubmissionFile(payload.record, file);
      const response = await streamRepositoryFile({
        request,
        env,
        token,
        file,
        download: Boolean(fileRoute[3])
      });
      return corsResponse(response, request, env);
    } catch (error) {
      const status = Number(error.status || 500);
      const message = status >= 500
        ? (error.publicMessage || "파일을 불러오는 중 오류가 발생했습니다.")
        : error.message;
      console.error(error);
      return corsJson({ message }, request, env, status);
    }
  }
};

async function buildManifest({ request, env, token, submissionId, outputId }) {
  const context = await loadSubmissionContext({ env, token, submissionId, outputId });
  const origin = new URL(request.url).origin;
  const query = `?outputId=${encodeURIComponent(context.outputId)}`;
  const files = context.files.map((file, index) => {
    validateSubmissionFile(context.record, file);
    const classified = classifyFile(file.name, context.record.type);
    const fileId = `f${index}`;
    const basePath = `/api/submissions/${encodeURIComponent(submissionId)}/files/${fileId}`;
    return {
      id: fileId,
      name: file.name,
      path: file.path,
      size: Number(file.size || 0),
      extension: classified.extension,
      kind: classified.kind,
      language: classified.language,
      mimeType: classified.mimeType,
      previewSupported: classified.previewSupported && Number(file.size || 0) <= MAX_INLINE_BYTES,
      previewUrl: `${origin}${basePath}${query}`,
      downloadUrl: `${origin}${basePath}/download${query}`,
      githubUrl: githubBlobUrl(env.REPOSITORY, file.path)
    };
  });

  return {
    version: 1,
    repository: env.REPOSITORY,
    branch: DEFAULT_BRANCH,
    outputId: context.outputId,
    submission: {
      submissionId: context.record.submissionId,
      phaseId: context.record.phaseId,
      issueNumber: context.record.issueNumber,
      taskId: context.record.taskId || null,
      taskText: context.record.taskText || "",
      outputId: context.record.outputId,
      outputText: context.record.outputText || "",
      uploader: context.record.uploader || "",
      memberName: context.record.memberName || "",
      memberFolder: context.record.memberFolder || "",
      type: context.record.type || "files",
      uploadedAt: context.record.uploadedAt || null,
      summary: context.record.summary || "제출본",
      serverPath: context.record.serverPath || null,
      folderPath: context.record.folderPath,
      folderUrl: context.record.folderUrl || githubTreeUrl(env.REPOSITORY, context.record.folderPath),
      classification: context.record.classification || null
    },
    files
  };
}

async function loadSubmissionContext({ env, token, submissionId, outputId }) {
  if (!/^[A-Za-z0-9_-]+$/.test(String(submissionId || ""))) {
    throw httpError(400, "제출본 ID가 올바르지 않습니다.");
  }
  const normalizedOutputId = outputId ? String(outputId).toUpperCase() : null;
  if (normalizedOutputId && !/^P\d{2}-T\d{2}-O\d{2}$/.test(normalizedOutputId)) {
    throw httpError(400, "산출물 ID가 올바르지 않습니다.");
  }

  const submissions = await loadJsonFile(SUBMISSIONS_PATH, token, env);
  const outputs = submissions.outputs && typeof submissions.outputs === "object" ? submissions.outputs : {};
  const matches = [];
  for (const [candidateOutputId, records] of Object.entries(outputs)) {
    if (normalizedOutputId && candidateOutputId.toUpperCase() !== normalizedOutputId) continue;
    for (const record of Array.isArray(records) ? records : []) {
      if (String(record?.submissionId || "") === submissionId) {
        matches.push({ outputId: candidateOutputId.toUpperCase(), record });
      }
    }
  }
  if (!matches.length) throw httpError(404, "제출본을 찾지 못했습니다.");
  if (matches.length > 1 && !normalizedOutputId) {
    throw httpError(409, "같은 제출본 ID가 여러 산출물에 있어 outputId가 필요합니다.");
  }

  const match = matches[0];
  const files = Array.isArray(match.record.files)
    ? match.record.files.filter((item) => item && typeof item === "object" && item.name && item.path)
    : [];
  return { ...match, files };
}

async function streamRepositoryFile({ request, env, token, file, download }) {
  const metadata = await githubJson(
